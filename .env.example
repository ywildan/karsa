# =============================================================================
# Karsa — .env.example
# -----------------------------------------------------------------------------
# Salin jadi `.env` lalu isi nilainya:  cp .env.example .env
# File `.env` TIDAK boleh di-commit (sudah masuk .gitignore).
# =============================================================================

# --- Database (Supabase / Neon / Postgres) -----------------------------------
# DATABASE_URL  → koneksi POOLED (Supavisor / PgBouncer) untuk runtime Next.js.
#                 Supabase: Connection pooling → port 6543, tambahkan
#                 `?pgbouncer=true&connection_limit=1`.
# DIRECT_URL    → koneksi LANGSUNG, dipakai Prisma untuk `db push`,
#                 `migrate`, dan `db seed`. Supabase: port 5432.
# Ganti [PASSWORD] dan [PROJECT-REF] sesuai project-mu.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- NextAuth v5 (Auth.js) ---------------------------------------------------
# WAJIB di-set saat deploy (Vercel → Settings → Environment Variables).
# Buat nilai BARU khusus produksi — jangan pakai nilai dev/sandbox.
# Generate dengan:
#   npx auth secret              (paling praktis, otomatis menulis ke .env)
#   atau: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Wajib di-set eksplisit saat deploy ke Vercel.
# Local: http://localhost:3000  |  Produksi: https://domain-kamu
AUTH_URL="http://localhost:3000"
# Percayai host header dari proxy lokal / Vercel.
AUTH_TRUST_HOST="true"

# --- Google OAuth ------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://domain-produksi/api/auth/callback/google
AUTH_GOOGLE_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"

# --- Notifikasi laporan Karsa Lib (opsional, Resend) -------------------------
# Tanpa konfigurasi ini, laporan tetap masuk dashboard /admin/karsalib.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
KARSA_LIB_REPORT_EMAIL="pengelola@example.com"
# Alamat/domain pengirim harus sudah diverifikasi pada akun Resend.
KARSA_LIB_REPORT_FROM="Karsa Lib <noreply@example.com>"

# --- AI artikel Karsa Lib — Teman Baca (fitur aktif; default nonaktif) --------
# Jalankan prisma/karsa-lib-ai.sql sebelum mengaktifkan fitur.
# Endpoint harus kompatibel dengan POST <AI_BASE_URL>/chat/completions.
# Base URL juga bisa diedit dari dashboard /admin/ai-premium (tabel
# LibAiSetting kunci "base_url" menang atas env; env = nilai awal/fallback).
# Key hanya disimpan di server; jangan memakai NEXT_PUBLIC_ untuk nilai ini.
AI_ENABLED="false"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""
AI_TOKEN_PARAMETER="max_completion_tokens"
AI_USER_DAILY_LIMIT="5"
AI_USER_SUMMARY_DAILY_LIMIT="3"
# Catatan: limit global ini sekarang bisa diedit dari dashboard admin
# /admin/ai-premium (tabel LibAiSetting menang atas env; env = nilai awal).
AI_GLOBAL_DAILY_LIMIT="100"
AI_MAX_OUTPUT_TOKENS="900"
AI_TIMEOUT_MS="20000"
# Harga opsional untuk estimasi biaya di dashboard /admin/ai-usage
# (USD per 1 juta token). Isi sesuai harga model/combo yang dipakai;
# kosongkan bila belum tahu — token tetap tercatat, biaya tampil kosong.
AI_PRICE_INPUT_PER_MILLION_USD=""
AI_PRICE_OUTPUT_PER_MILLION_USD=""
# Provider cadangan (fallback) — opsional. Provider resmi yang dihubungi
# langsung saat provider utama gagal (mis. instance Kaggle mati): request
# dicoba tepat satu kali ke fallback. Aktif hanya bila KETIGA nilai pertama
# terisi dan valid; tidak lengkap/tidak valid = fallback dianggap tidak ada.
# Jalankan prisma/ai-fallback-provider.sql agar traffic fallback tercatat
# terpisah ("Per provider") di dashboard /admin/ai-usage.
AI_FALLBACK_BASE_URL=""
AI_FALLBACK_API_KEY=""
AI_FALLBACK_MODEL=""
# Opsional; kosong = mengikuti AI_TOKEN_PARAMETER provider utama.
AI_FALLBACK_TOKEN_PARAMETER=""
# Harga fallback untuk estimasi biaya (USD per 1 juta token).
AI_FALLBACK_PRICE_INPUT_PER_MILLION_USD=""
AI_FALLBACK_PRICE_OUTPUT_PER_MILLION_USD=""
# Kurs tampilan IDR untuk toggle mata uang dashboard penggunaan AI
# (rupiah per 1 USD). Hanya memengaruhi tampilan; data tetap disimpan USD.
AI_USD_IDR_RATE="17900"

# --- Web search Teman Baca (Tavily; opsional, default nonaktif) --------------
# Aktif saat AI_SEARCH_ENABLED="true" + API key diisi. Key hanya di server.
# Default nilai mengikuti lib/karsa-lib/ai-search.ts dan lihat docs/TEMAN-BACA.md.
AI_SEARCH_ENABLED="false"
AI_SEARCH_API_KEY=""
AI_SEARCH_MAX_RESULTS="5"
AI_SEARCH_TIMEOUT_MS="8000"
# Kuota web search per tier User.premium_tier (default dari lib/karsa-lib/ai-policy.ts):
# gratis 3x/bulan, premium 3x/hari, plus 5x/hari, global 100/hari.
AI_WEBSEARCH_FREE_LIMIT="3"
AI_WEBSEARCH_PREMIUM_LIMIT="3"
AI_WEBSEARCH_PLUS_LIMIT="5"
AI_WEBSEARCH_GLOBAL_LIMIT="100"

# --- Aturan domain (Karsa hanya untuk UNTIDAR) -------------------------------
# Hanya email dengan domain ini yang boleh login.
ALLOWED_EMAIL_DOMAINS="students.untidar.ac.id,untidar.ac.id"

# --- Seed (opsional, dipakai prisma/seed.ts) ---------------------------------
# Kalau diisi dan user-nya sudah pernah login, user itu dipromosikan jadi admin.
ADMIN_EMAIL=""
# Data uji (5 test user + Prodi TI + 2 Matkul + Kelas TI-01 + PoinLog contoh)
# untuk Dev Quick Login Fase 1. Set "false" saat seed ke database produksi.
SEED_TEST_DATA="true"
# Override semester yang di-seed:
# SEED_SEMESTER_NAME="Ganjil 2026/2027"
# SEED_SEMESTER_START="2026-09-01"
# SEED_SEMESTER_END="2027-01-31"
