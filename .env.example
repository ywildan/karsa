# =============================================================================
# Karsa — .env.example
# -----------------------------------------------------------------------------
# Salin jadi `.env` lalu isi nilainya:  cp .env.example .env
# File `.env` TIDAK boleh di-commit (sudah masuk .gitignore).
# =============================================================================

# --- Database (Supabase / Neon / Postgres) -----------------------------------
# DATABASE_URL  → koneksi POOLED (Supavisor / PgBouncer) untuk runtime Next.js.
#                 Supabase: Connection pooling → port 6543, tambahkan
#                 `?pgbouncer=true&connection_limit=1`.
# DIRECT_URL    → koneksi LANGSUNG, dipakai Prisma untuk `db push`,
#                 `migrate`, dan `db seed`. Supabase: port 5432.
# Ganti [PASSWORD] dan [PROJECT-REF] sesuai project-mu.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- NextAuth v5 (Auth.js) ---------------------------------------------------
# Hasilkan dengan:  npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Wajib di-set eksplisit saat deploy ke Vercel.
# Local: http://localhost:3000  |  Produksi: https://domain-kamu
AUTH_URL="http://localhost:3000"
# Percayai host header dari proxy lokal / Vercel.
AUTH_TRUST_HOST="true"

# --- Google OAuth ------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://domain-produksi/api/auth/callback/google
AUTH_GOOGLE_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"

# --- Aturan domain (Karsa hanya untuk UNTIDAR) -------------------------------
# Hanya email dengan domain ini yang boleh login.
ALLOWED_EMAIL_DOMAINS="students.untidar.ac.id,untidar.ac.id"

# --- Seed (opsional, dipakai prisma/seed.ts) ---------------------------------
# Kalau diisi dan user-nya sudah pernah login, user itu dipromosikan jadi admin.
ADMIN_EMAIL=""
# Override semester yang di-seed:
# SEED_SEMESTER_NAME="Ganjil 2026/2027"
# SEED_SEMESTER_START="2026-09-01"
# SEED_SEMESTER_END="2027-01-31"
