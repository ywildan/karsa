// ============================================================================
// Karsa — prisma/schema.prisma
// Sistem Pencatatan Poin Keaktifan Mahasiswa UNTIDAR
// ----------------------------------------------------------------------------
// CATATAN PENTING (Fase 0)
//
//  * Schema ini = sumber kebenaran struktur data (PRD §5).
//  * Untuk membuat tabel di Supabase TANPA `prisma db push`
//    (mis. dari sandbox yang tidak bisa unduh engine Prisma), jalankan
//    `prisma/init.sql` di Supabase SQL Editor. Isi init.sql adalah cermin
//    dari schema ini — kalau schema berubah, update keduanya.
//  * DATABASE_URL = koneksi pooled (Supavisor, port 6543) untuk runtime app.
//    DIRECT_URL   = koneksi langsung (port 5432) untuk db push / seed / studio.
//  * Konvensi: model PascalCase (= nama tabel), field snake_case (= nama kolom).
//    Auth.js (NextAuth v5) memakai nama camelCase khusus: emailVerified,
//    userId, providerAccountId, sessionToken — jangan diubah.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identitas & Auth
// ---------------------------------------------------------------------------

/// User — diisi otomatis saat login Google (NextAuth v5 + @auth/prisma-adapter).
/// `kelas_id = null` berarti "user tanpa kelas" (PRD §7.4).
/// `is_admin` satu-satunya penanda hak akses admin (PRD §6).
model User {
  id            String    @id @default(cuid())
  name          String?
  /// NIM — hanya untuk mahasiswa. Admin boleh NULL.
  /// Wajib ada karena header rapor menampilkan NIM (PRD §7.3).
  nim           String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  is_admin      Boolean   @default(false)
  kelas_id      String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  kelas                Kelas?              @relation(fields: [kelas_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  accounts             Account[]
  sessions             Session[]
  kelasMatkulAsPj      KelasMatkul[]       @relation("KelasMatkulPj")
  poinLogsAsMahasiswa  PoinLog[]           @relation("PoinLogMahasiswa")
  poinLogsAsPj         PoinLog[]           @relation("PoinLogPj")
  mobileAuthRequests   MobileAuthRequest[]
  mobileSessions       MobileSession[]
  groupMessages        GroupMessage[]      @relation("GroupMessageAuthor")
  groupMessagesHidden  GroupMessage[]      @relation("GroupMessageHiddenBy")
  groupMessagesPinned  GroupMessage[]      @relation("GroupMessagePinnedBy")
  groupReports         GroupReport[]       @relation("GroupReportReporter")
  groupReportsResolved GroupReport[]       @relation("GroupReportResolver")
  groupBlocksCreated   GroupBlock[]        @relation("GroupBlocker")
  groupBlocksReceived  GroupBlock[]        @relation("GroupBlocked")
  groupsLocked         KelasMatkul[]       @relation("KelasMatkulGroupLocker")

  @@index([kelas_id])
}

/// Account — menyimpan tautan akun OAuth (Google). Wajib untuk Auth.js adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Session — tidak dipakai selama strategy JWT, disediakan untuk kompatibilitas.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

/// VerificationToken — standar Auth.js (magic link / email verification).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Master akademik
// ---------------------------------------------------------------------------

/// Semester — hanya satu yang boleh `is_active = true` (PRD §9).
model Semester {
  id         String   @id @default(cuid())
  name       String   @unique // contoh: "Ganjil 2026/2027"
  start_date DateTime
  end_date   DateTime
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  kelas Kelas[]
}

/// Prodi — program studi.
model Prodi {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  kelas Kelas[]
}

/// Matkul — master mata kuliah, dipakai lintas kelas.
model Matkul {
  id         String   @id @default(cuid())
  name       String
  code       String?  @unique // kode matkul opsional, mis. "TIF1101"
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  kelasMatkul KelasMatkul[]
}

/// Kelas — rombongan belajar pada satu prodi & satu semester.
/// Unique (name, prodi_id, semester_id) sesuai PRD §3.
model Kelas {
  id          String   @id @default(cuid())
  name        String
  prodi_id    String
  semester_id String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  prodi       Prodi         @relation(fields: [prodi_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  semester    Semester      @relation(fields: [semester_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users       User[]
  kelasMatkul KelasMatkul[]

  @@unique([name, prodi_id, semester_id])
  @@index([prodi_id])
  @@index([semester_id])
}

// ---------------------------------------------------------------------------
// Pencatatan poin
// ---------------------------------------------------------------------------

/// KelasMatkul — satu matkul yang diajarkan di satu kelas, dipegang 1 PJ.
/// Unique (kelas_id, matkul_id) sesuai PRD §3.
model KelasMatkul {
  id                 String    @id @default(cuid())
  kelas_id           String
  matkul_id          String
  pj_id              String
  group_locked_at    DateTime?
  group_locked_by_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt

  kelas         Kelas          @relation(fields: [kelas_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  matkul        Matkul         @relation(fields: [matkul_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pj            User           @relation("KelasMatkulPj", fields: [pj_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  groupLockedBy User?          @relation("KelasMatkulGroupLocker", fields: [group_locked_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  poinLogs      PoinLog[]
  groupMessages GroupMessage[]

  @@unique([kelas_id, matkul_id])
  @@index([kelas_id])
  @@index([matkul_id])
  @@index([pj_id])
  @@index([group_locked_by_id])
}

/// KategoriPoin — Bertanya · Menjawab · Presentasi · Lainnya (di-seed).
model KategoriPoin {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  poinLogs PoinLog[]
}

/// PoinLog — satu baris pencatatan = satu "karsa".
/// Tidak ada poin lepas: setiap baris wajib terikat `kelas_matkul_id` (PRD §3).
/// `poin` 1–4 divalidasi di server (Zod) + dijaga CHECK constraint di DB.
model PoinLog {
  id              String   @id @default(cuid())
  kelas_matkul_id String
  mahasiswa_id    String
  pj_id           String
  kategori_id     String
  poin            Int
  catatan         String?
  idempotency_key String?  @unique
  created_at      DateTime @default(now())

  kelasMatkul KelasMatkul  @relation(fields: [kelas_matkul_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mahasiswa   User         @relation("PoinLogMahasiswa", fields: [mahasiswa_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pj          User         @relation("PoinLogPj", fields: [pj_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kategori    KategoriPoin @relation(fields: [kategori_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([kelas_matkul_id])
  @@index([mahasiswa_id])
  @@index([pj_id])
  @@index([kategori_id])
  @@index([created_at])
  @@index([kelas_matkul_id, mahasiswa_id])
}

// ---------------------------------------------------------------------------
// Sesi aplikasi native
// ---------------------------------------------------------------------------

/// Permintaan login browser → aplikasi. Authorization code hanya disimpan
/// sebagai hash, berumur pendek, sekali pakai, dan diikat ke PKCE challenge.
model MobileAuthRequest {
  id             String    @id @default(cuid())
  state          String
  code_challenge String
  redirect_uri   String
  user_id        String?
  code_hash      String?   @unique
  expires_at     DateTime
  consumed_at    DateTime?
  created_at     DateTime  @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expires_at])
  @@index([user_id])
}

/// Sesi bearer untuk aplikasi native. Token mentah hanya pernah diberikan ke
/// perangkat; database menyimpan SHA-256 agar kebocoran DB tidak menjadi sesi.
model MobileSession {
  id                 String    @id @default(cuid())
  user_id            String
  access_token_hash  String    @unique
  refresh_token_hash String    @unique
  access_expires_at  DateTime
  refresh_expires_at DateTime
  revoked_at         DateTime?
  last_used_at       DateTime  @default(now())
  device_name        String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id, revoked_at])
  @@index([refresh_expires_at])
}

// ---------------------------------------------------------------------------
// Grup percakapan mobile-only
// ---------------------------------------------------------------------------

/// Satu pesan teks di grup yang direpresentasikan oleh KelasMatkul.
/// Body menjadi NULL hanya setelah pesan yang sudah deleted/hidden dipurge.
model GroupMessage {
  id              String    @id @default(cuid())
  kelas_matkul_id String
  author_id       String
  reply_to_id     String?
  body            String?   @db.Text
  idempotency_key String    @unique
  edited_at       DateTime?
  deleted_at      DateTime?
  hidden_at       DateTime?
  hidden_by_id    String?
  hidden_reason   String?
  pinned_at       DateTime?
  pinned_by_id    String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  kelasMatkul KelasMatkul    @relation(fields: [kelas_matkul_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author      User           @relation("GroupMessageAuthor", fields: [author_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replyTo     GroupMessage?  @relation("GroupMessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies     GroupMessage[] @relation("GroupMessageReplies")
  hiddenBy    User?          @relation("GroupMessageHiddenBy", fields: [hidden_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  pinnedBy    User?          @relation("GroupMessagePinnedBy", fields: [pinned_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reports     GroupReport[]

  @@index([kelas_matkul_id, created_at(sort: Desc), id(sort: Desc)])
  @@index([kelas_matkul_id, updated_at(sort: Desc)])
  @@index([author_id])
  @@index([reply_to_id])
  @@index([kelas_matkul_id, pinned_at(sort: Desc)])
}

/// Laporan eksplisit dari anggota grup terhadap satu pesan.
model GroupReport {
  id             String    @id @default(cuid())
  message_id     String
  reporter_id    String
  reason         String
  details        String?   @db.Text
  status         String    @default("OPEN")
  resolved_at    DateTime?
  resolved_by_id String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  message    GroupMessage @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reporter   User         @relation("GroupReportReporter", fields: [reporter_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy User?        @relation("GroupReportResolver", fields: [resolved_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([message_id, reporter_id])
  @@index([message_id, status])
  @@index([reporter_id, created_at(sort: Desc)])
  @@index([resolved_by_id])
}

/// Preferensi block milik pengguna; tidak menghapus pesan dari anggota lain.
model GroupBlock {
  blocker_id String
  blocked_id String
  created_at DateTime @default(now())

  blocker User @relation("GroupBlocker", fields: [blocker_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blocked User @relation("GroupBlocked", fields: [blocked_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([blocker_id, blocked_id])
  @@index([blocked_id])
}

/// Riwayat input/penghapusan poin dari aplikasi. Snapshot dipertahankan saat
/// PoinLog dihapus; tidak ada FK agar retensi data akademik dapat diatur terpisah.
model AuditLog {
  id String @id @default(cuid())

  // Siapa yang melakukan
  actor_id   String
  actor_name String
  actor_role String

  // Apa yang dilakukan
  action       String
  entity_type  String
  entity_id    String
  entity_label String?

  // Konteks snapshot untuk filter cepat
  kelas_id     String?
  kelas_label  String?
  matkul_id    String?
  matkul_label String?

  // Perubahan
  before   Json?
  after    Json?
  metadata Json?

  created_at DateTime @default(now())

  @@index([kelas_id, created_at(sort: Desc)])
  @@index([action, created_at(sort: Desc)])
  @@index([actor_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
}
