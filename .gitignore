# =============================================================================
# Karsa — .gitignore
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output Next.js
/.next/
/out/
build
dist

# Production
*.tsbuildinfo

# Environment — JANGAN pernah di-commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Prisma
/prisma/migrations/dev.db
/prisma/*.db
/prisma/*.db-journal

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor & OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.pem
*.jks
*.keystore
Thumbs.db

# Vercel
.vercel

# Testing / cache
/coverage
/.turbo
