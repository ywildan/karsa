<?xml version="1.0" encoding="utf-8"?>
<!-- Latar cream yang sama dengan KarsaColors.background, plus logo 96dp
     agar posisi dan ukurannya menyambung ke splash Flutter. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFBF7" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
